# ==============================================================================
# Caliber & Garmin Telemetry Pipeline - Environment Configuration
# Copy this file to .env and populate the required keys.
# ==============================================================================

# --- Caliber MCP Authentication ---
# Initial refresh token obtained from running `python scripts/bootstrap_caliber_auth.py`
CALIBER_REFRESH_TOKEN=your_caliber_refresh_token_here
CALIBER_MCP_URL=https://api.caliberstrong.com/mcp
CALIBER_CLIENT_ID=caliber-mcp

# --- Garmin Connect Personal API ---
# Static Bearer API Key from the Garmin Developer Portal
GARMIN_PERSONAL_API_KEY=your_garmin_personal_api_key_here
GARMIN_API_BASE_URL=https://apis.garmin.com

# --- Google Sheets & Google Drive Integration ---
# Path to Google Service Account JSON file (for local runs)
# Or paste raw JSON string in GOOGLE_SERVICE_ACCOUNT_JSON (for GitHub Actions)
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
# GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}
# Name or ID of the Google Sheet created for synchronization
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SHEET_NAME=Caliber_Daily_Sync

# --- GitHub Actions Secret Rotation (Required for CI/CD) ---
# GitHub Personal Access Token scoped to repo secrets (Secrets: Read & Write)
GH_PAT=ghp_your_fine_grained_pat_here
GITHUB_REPOSITORY=owner/Workout_Status_Tool

# --- Pipeline Logging & Debugging ---
LOG_LEVEL=INFO
